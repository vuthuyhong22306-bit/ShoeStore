<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D5DB" />

    <!-- Title and Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Chọn hoặc nhập Mã giảm giá"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseBottomSheet"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_delete_trash"
            app:tint="#757575" />
    </RelativeLayout>

    <!-- Code Input Box & Apply Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_pill_outlined"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/etCouponCodeInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Nhập mã giảm giá (VD: SHOE20)"
            android:inputType="textCapCharacters"
            android:textColor="#111111"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnApplyEnteredCode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_red_pill"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Áp dụng"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Error message text -->
    <TextView
        android:id="@+id/tvCouponErrorMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#E5192C"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Available Coupons Section Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:text="Mã giảm giá dành cho bạn"
        android:textColor="#111111"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Coupons RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCoupons"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />
</LinearLayout>
