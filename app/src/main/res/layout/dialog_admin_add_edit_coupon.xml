<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Code Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã giảm giá"
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCouponCode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_admin_chip_unselected"
            android:hint="VD: WELCOME10"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="14dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <!-- Discount Type Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Loại giảm giá"
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgDiscountType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Phần trăm (%)"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Số tiền (đ)"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- Discount Value Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Giá trị giảm"
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDiscountValue"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_admin_chip_unselected"
            android:hint="VD: 10 hoặc 50000"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <!-- Min Order Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Đơn tối thiểu (đ)"
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMinOrderValue"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_admin_chip_unselected"
            android:hint="VD: 500000"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <!-- Expiry Date Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Hạn sử dụng (ngày)"
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_admin_chip_unselected"
            android:focusable="false"
            android:clickable="true"
            android:hint="Chọn ngày hết hạn (dd/MM/yyyy)"
            android:paddingHorizontal="14dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <!-- Total Usage Limit Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tổng số lượt sử dụng tối đa"
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMaxUsage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_admin_chip_unselected"
            android:hint="VD: 100"
            android:inputType="number"
            android:text="100"
            android:paddingHorizontal="14dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>