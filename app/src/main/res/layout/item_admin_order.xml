<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Line 1: Order ID & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvOrderCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn #DH0125"
                android:textColor="#1C1C1E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tvOrderStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ xác nhận"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#D0343C"
                android:background="@drawable/bg_badge_pink"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />

        </RelativeLayout>

        <!-- Line 2: Customer info, date, product count / cancellation reason -->
        <TextView
            android:id="@+id/tvOrderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A · 10/11/2026 · 2 sản phẩm"
            android:textColor="#6B6B6B"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <!-- Line 3: Price & Action Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvOrderTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.880.000đ"
                android:textColor="#1C1C1E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOrderDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Chi tiết"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_admin_outlined"
                    android:paddingHorizontal="16dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOrderUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:text="Cập nhật"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_admin_red"
                    android:paddingHorizontal="16dp" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>