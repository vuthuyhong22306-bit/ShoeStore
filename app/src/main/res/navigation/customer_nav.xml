<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customer_nav"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.shoestore.ui.fragment.HomeFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_cart"
        android:name="com.example.shoestore.ui.fragment.CartFragment"
        android:label="Giỏ hàng"
        tools:layout="@layout/fragment_cart" />

    <fragment
        android:id="@+id/nav_orders"
        android:name="com.example.shoestore.ui.fragment.OrdersFragment"
        android:label="Đơn hàng"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/nav_account"
        android:name="com.example.shoestore.ui.fragment.AccountFragment"
        android:label="Tài khoản"
        tools:layout="@layout/fragment_account" />
</navigation>
